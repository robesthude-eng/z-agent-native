{
  "name": "z-agent-native",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Standalone web AI agent runtime with native sessions, tools, workspaces, terminal, questions, permissions, and direct LLM providers.",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "dev:server": "node --env-file-if-exists=.env server/index.mjs",
    "dev:web": "vite",
    "build": "npm run typecheck && npm run build:web",
    "build:web": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "vitest run",
    "test:native": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "eval:validate": "node scripts/validate-agent-evals.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "preview": "vite preview",
    "eval:run": "node --env-file-if-exists=.env scripts/run-agent-evals.mjs",
    "eval:smoke": "node --env-file-if-exists=.env scripts/run-agent-evals.mjs --smoke",
    "docs:check": "node scripts/check-capability-docs.mjs",
    "telemetry:summary": "node --env-file-if-exists=.env scripts/summarize-turn-telemetry.mjs",
    "lint:ci": "biome lint .",
    "format:check": "biome format .",
    "architecture:check": "node scripts/check-ui-boundaries.mjs",
    "quality:quick": "npm run typecheck && npm run architecture:check && npm run lint:ci && npm run format:check && npm test && npm run docs:check && npm run eval:validate && npm run eval:benchmark:validate",
    "quality": "npm run quality:quick && npm run test:native && npm run build:web",
    "eval:benchmark": "node --env-file-if-exists=.env scripts/run-repo-benchmark.mjs",
    "eval:benchmark:validate": "node scripts/validate-repo-benchmark.mjs",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.mjs",
    "db:backup": "node --env-file-if-exists=.env server/backup.mjs",
    "supplychain:check": "node scripts/check-workflow-pins.mjs",
    "audit:verify": "node --env-file-if-exists=.env server/audit-verify.mjs",
    "db:restore-verify": "node --env-file-if-exists=.env server/restore-verify.mjs",
    "db:drill": "node --env-file-if-exists=.env scripts/dr-drill.mjs",
    "prod:env:init": "node scripts/init-production-env.mjs",
    "release:check": "npm run supplychain:check && npm run docs:check && npm run eval:validate && npm run eval:benchmark:validate && npm run eval:smoke && npm run test:native"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@sentry/react": "^10.68.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-router": "^1.170.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "border-beam": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.27.0",
    "playwright": "1.61.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@biomejs/biome": "2.5.3",
    "@playwright/test": "^1.61.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^19.1.0-rc.2",
    "jsdom": "^23.2.0",
    "tailwindcss": "^4.1.14",
    "typescript": "7.0.2",
    "vite": "^8.1.5",
    "vitest": "4.1.10"
  }
}
