{
  "name": "z-agent-native",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Standalone web AI agent runtime with native sessions, tools, workspaces, terminal, questions, permissions, and direct LLM providers.",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node server/index.mjs",
    "dev:server": "node server/index.mjs",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "test:native": "node --test tests/*.test.mjs",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@sentry/react": "^10.68.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-router": "^1.170.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@biomejs/biome": "2.5.3",
    "@playwright/test": "^1.61.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^19.1.0-rc.2",
    "jsdom": "^23.2.0",
    "tailwindcss": "^4.1.14",
    "typescript": "7.0.2",
    "vite": "^8.1.5",
    "vitest": "4.1.10"
  }
}
