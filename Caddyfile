agentwill.online {
	# Browser hardening at the public TLS boundary. Application HTML also
	# carries its own CSP from the Node runtime; these headers cover API and
	# preview responses without granting additional browser capabilities.
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}

	# Never compress the event stream. gzip/zstd buffer SSE comments and
	# mobile Chrome then aborts the HTTP/2 stream in a few milliseconds
	# (Caddy: "aborting with incomplete response / context canceled").
	encode zstd gzip {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
			header Content-Type application/wasm*
			header Content-Type font/*
			header Content-Type application/font*
		}
	}

	# Metrics are an operator surface even though the application also requires
	# a bearer token. Do not expose the endpoint through the public TLS vhost at
	# all; scrape it over the loopback/private runtime path instead.
	@metrics path /metrics
	respond @metrics 404

	@sse path /api/event*
	handle @sse {
		reverse_proxy z-agent:3000 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	@socket path /socket.io*
	handle @socket {
		reverse_proxy z-agent:3000 {
			flush_interval -1
			transport http {
				read_timeout 0
				write_timeout 0
			}
		}
	}

	handle {
		reverse_proxy z-agent:3000 {
			flush_interval -1
		}
	}
}

www.agentwill.online {
	redir https://agentwill.online{uri} permanent
}

:80 {
	redir https://agentwill.online{uri} permanent
}
