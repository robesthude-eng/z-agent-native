# Runtime
PORT=3000
Z_AGENT_DATA_DIR=./data
Z_AGENT_WORKSPACES_DIR=./workspaces

# Optional hard step budget for one agent turn (1..128).
# Leave empty to let the runtime size the budget from task complexity.
Z_AGENT_MAX_STEPS=
Z_AGENT_SUBAGENT_STEPS=10
Z_AGENT_CONTEXT_CHARS=360000
Z_AGENT_TOOL_TIMEOUT_MS=120000
Z_AGENT_MAX_UPLOAD_BYTES=262144000
Z_AGENT_SESSION_TTL_MS=604800000

# Unsafe single-user development fallback for a non-root bare-metal runtime.
# Keep this 0 in production. Docker uses per-session Unix UID isolation automatically.
Z_AGENT_ALLOW_UNISOLATED_SHELL=0

# Registration is closed by default once the first (admin) account exists.
# Set an invite code, or set Z_AGENT_ALLOW_OPEN_REGISTRATION=1 for a public instance.
Z_AGENT_INVITE_CODE=
Z_AGENT_ALLOW_OPEN_REGISTRATION=0

# Set to 1 only when the app is served through HTTPS.
Z_AGENT_SECURE_COOKIES=0

# Set to 1 only when a reverse proxy in front of the runtime sets X-Forwarded-For.
# When 0, auth rate limiting keys on the direct socket address.
Z_AGENT_TRUST_PROXY=0

# Browser origins allowed to open the terminal socket, comma separated.
# Leave empty to require Origin to match the Host header.
Z_AGENT_ALLOWED_ORIGINS=

# Optional. If omitted, runtime generates data/master.key with mode 0600.
# Use a stable 32-byte base64 key (or a long secret) in clustered deployments.
Z_AGENT_SECRET_KEY=

# Multi-node coordination (off by default). When 1, turn locks, replica
# heartbeats and the SSE event bus go through the shared SQLite file so two
# processes cannot run the same chat. A second replica also needs a shared
# Z_AGENT_DATA_DIR / volume AND a shared Z_AGENT_WORKSPACES_DIR — the lock
# lives in SQLite, the files do not. Leave this 0 on a single container.
Z_AGENT_CLUSTER=0
# Optional stable replica name. Empty → node-<8 hex> at startup.
Z_AGENT_INSTANCE_ID=
# How long a replica may hold a turn lock without renewing it (2s..10min).
Z_AGENT_CLUSTER_LOCK_TTL_MS=15000
# How often a replica polls the shared event bus (50ms..60s).
Z_AGENT_CLUSTER_POLL_MS=250

# Optional pinned SHA-256 checksums for provisioned toolchains, as JSON:
# {"java:21":"<sha256>","gradle:8.14.5":"<sha256>"}
# Without a pin the runtime falls back to the checksum published next to the
# artifact, which only detects corruption, not a compromised mirror.
Z_AGENT_TOOLCHAIN_SHA256=

# Optional native websearch tool.
BRAVE_SEARCH_API_KEY=

# Optional default model when the client did not explicitly select one.
# Example: Z_AGENT_DEFAULT_MODEL=anthropic/claude-sonnet-4-6
Z_AGENT_DEFAULT_MODEL=

# DANGEROUS, OFF BY DEFAULT. When set, every external provider request is routed
# through this HTTPS relay, which therefore sees provider API keys and full
# prompt/response bodies in clear text. Only set this to a relay you operate.
Z_AGENT_RELAY_URL=
