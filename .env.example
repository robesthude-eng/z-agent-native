# Runtime
PORT=3000
Z_AGENT_DATA_DIR=./data
Z_AGENT_WORKSPACES_DIR=./workspaces

# Optional hard step budget for one agent turn (1..128).
# Leave empty to let the runtime size the budget from task complexity.
Z_AGENT_MAX_STEPS=
Z_AGENT_SUBAGENT_STEPS=10
Z_AGENT_CONTEXT_CHARS=360000
# Default 10 minutes. One bash/build may run this long inside a 30-minute turn.
Z_AGENT_TOOL_TIMEOUT_MS=600000
# Abort a model stream only after this much silence (not wall-clock).
Z_AGENT_PROVIDER_STREAM_IDLE_MS=180000
# Absolute ceiling for one model stream (30 minutes).
Z_AGENT_PROVIDER_STREAM_HARD_MS=1800000
Z_AGENT_MAX_UPLOAD_BYTES=262144000
Z_AGENT_MAX_INFLIGHT_UPLOAD_BYTES=536870912
Z_AGENT_GREP_TIMEOUT_MS=5000
Z_AGENT_DURABLE_JOB_TTL_MS=86400000
Z_AGENT_SESSION_TTL_MS=604800000
# Readiness fails before the persistent data/workspace filesystem is critically full.
# Default is 256 MiB; raise this on larger production hosts.
Z_AGENT_MIN_FREE_BYTES=268435456

# Unsafe single-user development fallback for a non-root bare-metal runtime.
# Keep this 0 in production. Docker uses per-session Unix UID isolation automatically.
Z_AGENT_ALLOW_UNISOLATED_SHELL=0

# Agent shell intent guard: guarded (default), tool-only, or open. In hardened
# Docker this is defense in depth: arbitrary agent code executes in the sibling
# z-agent-executor service with Docker network_mode:none.
Z_AGENT_SHELL_NETWORK_POLICY=guarded
# Block direct agent reads/grep/shell references to common credential files.
# Set to allow only for trusted single-user compatibility workloads.
Z_AGENT_SENSITIVE_FILE_POLICY=block

# Model-selected network tools (webfetch/websearch/browser) are fail-closed:
# off = default; no model-selected external network
# allowlist = exact Z_AGENT_NETWORK_ALLOWLIST hosts; use *.example.com explicitly for subdomains
# public = any SSRF-safe public host (trusted single-user compatibility)
Z_AGENT_NETWORK_POLICY=off
Z_AGENT_NETWORK_ALLOWLIST=


# Local/bare-metal default is optional. Production Compose overrides this to 1
# so a missing isolation service fails closed instead of falling back locally.
Z_AGENT_EXECUTOR_REQUIRED=0
Z_AGENT_EXECUTOR_SOCKET=/run/z-agent-executor/executor.sock
Z_AGENT_EXECUTOR_NPROC=256
Z_AGENT_EXECUTOR_NOFILE=2048
Z_AGENT_EXECUTOR_FILE_BYTES=536870912
Z_AGENT_BROWSER_REQUIRED=0
Z_AGENT_BROWSER_SOCKET=/run/z-agent-browser/browser.sock
# Networked dependency installers are intentionally absent from hardened mode.
# Bake dependencies into the image/operator workflow instead.
Z_AGENT_ALLOW_NETWORKED_INSTALLERS=0

# Privacy-minimized per-turn JSONL telemetry (no prompt/tool output bodies).
# Empty means <Z_AGENT_DATA_DIR>/turn-telemetry.jsonl.
Z_AGENT_TELEMETRY_FILE=
Z_AGENT_TELEMETRY_MAX_BYTES=52428800
# Optional cost estimates; prices are operator-supplied to avoid stale hard-coded
# vendor pricing. Values are USD per 1M input/output tokens.
# Example: {"provider/model":{"inputPerMillion":3,"outputPerMillion":15}}
Z_AGENT_MODEL_PRICING_JSON=


# Optional Prometheus endpoint. When empty, /metrics returns 404. When set,
# scrape with Authorization: Bearer <token>. No user/session IDs are labels.
Z_AGENT_METRICS_TOKEN=

# Registration is closed by default once the first (admin) account exists.
# Set an invite code, or set Z_AGENT_ALLOW_OPEN_REGISTRATION=1 for a public instance.
Z_AGENT_INVITE_CODE=
Z_AGENT_ALLOW_OPEN_REGISTRATION=0

# Set to 1 only when the app is served through HTTPS.
Z_AGENT_SECURE_COOKIES=0

# Set to 1 only when a reverse proxy in front of the runtime sets X-Forwarded-For.
# When 0, auth rate limiting keys on the direct socket address.
Z_AGENT_TRUST_PROXY=0

# Browser origins allowed to open the terminal socket, comma separated.
# Leave empty to require Origin to match the Host header.
Z_AGENT_ALLOWED_ORIGINS=

# Optional. If omitted, runtime generates data/master.key with mode 0600.
# Use a stable 32-byte base64 key (or a long secret) in clustered deployments.
Z_AGENT_SECRET_KEY=

# Multi-node coordination (off by default). When 1, turn locks, replica
# heartbeats and the SSE event bus go through the shared SQLite file so two
# processes cannot run the same chat. A second replica also needs a shared
# Z_AGENT_DATA_DIR / volume AND a shared Z_AGENT_WORKSPACES_DIR — the lock
# lives in SQLite, the files do not. Leave this 0 on a single container.
Z_AGENT_CLUSTER=0
# Optional stable replica name. Empty → node-<8 hex> at startup.
Z_AGENT_INSTANCE_ID=
# How long a replica may hold a turn lock without renewing it (2s..30min).
# A running turn also pulses the lock every 5s, so this is the crash-recovery window.
Z_AGENT_CLUSTER_LOCK_TTL_MS=120000
# How often a replica polls the shared event bus (50ms..60s).
Z_AGENT_CLUSTER_POLL_MS=250

# Optional pinned SHA-256 checksums for provisioned toolchains, as JSON:
# {"java:21":"<sha256>","gradle:8.14.5":"<sha256>"}
# Without a pin the runtime falls back to the checksum published next to the
# artifact, which only detects corruption, not a compromised mirror.
Z_AGENT_TOOLCHAIN_SHA256=

# Optional native websearch tool.
BRAVE_SEARCH_API_KEY=

# Optional default model when the client did not explicitly select one.
# Example: Z_AGENT_DEFAULT_MODEL=anthropic/claude-sonnet-4-6
Z_AGENT_DEFAULT_MODEL=

# DANGEROUS, OFF BY DEFAULT. When set, provider catalog/probe traffic is routed
# through this HTTPS relay, which therefore sees provider API keys and full
# prompt/response bodies in clear text. Only set this to a relay you operate.
# Streaming calls prefer the direct provider URL and fall back to the relay
# only if the direct path dies before the first token. Cloudflare Workers
# (and most serverless relays) cut HTTP streams after ~30–100s and cannot
# carry a 30-minute turn — use a long-lived HTTPS proxy, or leave this empty.
Z_AGENT_RELAY_URL=

# Interactive terminal runs in the API container and is intended only for trusted self-hosted use.
# Production Compose overrides this to 0.
Z_AGENT_TERMINAL_ENABLED=1
