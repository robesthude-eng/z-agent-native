FROM node:24-bookworm
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev \
    && npx playwright install --with-deps chromium \
    && apt-get update && apt-get install -y --no-install-recommends util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && npm cache clean --force
COPY server ./server
RUN mkdir -p /run/z-agent-browser && chown root:root /run/z-agent-browser && chmod 0700 /run/z-agent-browser
ENV Z_AGENT_BROWSER_SOCKET=/run/z-agent-browser/browser.sock \
    Z_AGENT_NETWORK_POLICY=off
CMD ["node", "server/browser-service.mjs"]
